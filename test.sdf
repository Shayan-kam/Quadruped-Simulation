    <model name='quadruped'>

      <link name='base_link'>

        <inertial>

          <pose>0 0 0 0 -0 0</pose>

          <mass>5</mass>

          <inertia>

            <ixx>0.10000000000000001</ixx>

            <ixy>0</ixy>

