<?xml version="1.0"?>
<robot name="quadruped">
  <link name="base_link">
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <visual><geometry><box size="0.4 0.2 0.1"/></geometry></visual>
    <collision><geometry><box size="0.4 0.2 0.1"/></geometry></collision>
  </link>

  <!-- FRONT LEFT -->
  <link name="FL_hip">
    <inertial><origin xyz="0 0.05 0"/><mass value="0.2"/><inertia ixx="0.005" iyy="0.005" izz="0.005"/></inertial>
    <visual><origin xyz="0 0.05 0"/><geometry><cylinder radius="0.02" length="0.1"/></geometry></visual>
    <collision><origin xyz="0 0.05 0"/><geometry><cylinder radius="0.02" length="0.1"/></geometry></collision>
  </link>
  <joint name="FL_hip_joint" type="revolute">
    <parent link="base_link"/><child link="FL_hip"/>
    <origin xyz="0.2 0.1 -0.02" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.3" upper="0.3" effort="1000" velocity="10.0"/>
  </joint>

  <link name="FL_leg">
    <inertial><origin xyz="0 0 -0.125"/><mass value="1.5"/><inertia ixx="0.01" iyy="0.01" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 -0.125"/><geometry><cylinder radius="0.025" length="0.25"/></geometry></visual>
    <collision><origin xyz="0 0 -0.125"/><geometry><cylinder radius="0.025" length="0.25"/></geometry></collision>
  </link>
  <joint name="FL_joint" type="revolute">
    <parent link="FL_hip"/><child link="FL_leg"/>
    <origin xyz="0 0.1 -0.02" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="1000" velocity="10.0"/>
  </joint>

  <!-- FRONT RIGHT -->
  <link name="FR_hip">
    <inertial><origin xyz="0 -0.05 0"/><mass value="0.2"/><inertia ixx="0.005" iyy="0.005" izz="0.005"/></inertial>
    <visual><origin xyz="0 -0.05 0"/><geometry><cylinder radius="0.02" length="0.1"/></geometry></visual>
    <collision><origin xyz="0 -0.05 0"/><geometry><cylinder radius="0.02" length="0.1"/></geometry></collision>
  </link>
  <joint name="FR_hip_joint" type="revolute">
    <parent link="base_link"/><child link="FR_hip"/>
    <origin xyz="0.2 -0.1 -0.02" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.3" upper="0.3" effort="1000" velocity="10.0"/>
  </joint>

  <link name="FR_leg">
    <inertial><origin xyz="0 0 -0.125"/><mass value="1.5"/><inertia ixx="0.01" iyy="0.01" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 -0.125"/><geometry><cylinder radius="0.025" length="0.25"/></geometry></visual>
    <collision><origin xyz="0 0 -0.125"/><geometry><cylinder radius="0.025" length="0.25"/></geometry></collision>
  </link>
  <joint name="FR_joint" type="revolute">
    <parent link="FR_hip"/><child link="FR_leg"/>
    <origin xyz="0 -0.1 -0.02" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="1000" velocity="10.0"/>
  </joint>

  <!-- BACK LEFT -->
  <link name="BL_hip">
    <inertial><origin xyz="0 0.05 0"/><mass value="0.2"/><inertia ixx="0.005" iyy="0.005" izz="0.005"/></inertial>
    <visual><origin xyz="0 0.05 0"/><geometry><cylinder radius="0.02" length="0.1"/></geometry></visual>
    <collision><origin xyz="0 0.05 0"/><geometry><cylinder radius="0.02" length="0.1"/></geometry></collision>
  </link>
  <joint name="BL_hip_joint" type="revolute">
    <parent link="base_link"/><child link="BL_hip"/>
    <origin xyz="-0.2 0.1 -0.02" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.3" upper="0.3" effort="1000" velocity="10.0"/>
  </joint>

  <link name="BL_leg">
    <inertial><origin xyz="0 0 -0.125"/><mass value="1.5"/><inertia ixx="0.01" iyy="0.01" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 -0.125"/><geometry><cylinder radius="0.025" length="0.25"/></geometry></visual>
    <collision><origin xyz="0 0 -0.125"/><geometry><cylinder radius="0.025" length="0.25"/></geometry></collision>
  </link>
  <joint name="BL_joint" type="revolute">
    <parent link="BL_hip"/><child link="BL_leg"/>
    <origin xyz="0 0.1 -0.02" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="1000" velocity="10.0"/>
  </joint>

  <!-- BACK RIGHT -->
  <link name="BR_hip">
    <inertial><origin xyz="0 -0.05 0"/><mass value="0.2"/><inertia ixx="0.005" iyy="0.005" izz="0.005"/></inertial>
    <visual><origin xyz="0 -0.05 0"/><geometry><cylinder radius="0.02" length="0.1"/></geometry></visual>
    <collision><origin xyz="0 -0.05 0"/><geometry><cylinder radius="0.02" length="0.1"/></geometry></collision>
  </link>
  <joint name="BR_hip_joint" type="revolute">
    <parent link="base_link"/><child link="BR_hip"/>
    <origin xyz="-0.2 -0.1 -0.02" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.3" upper="0.3" effort="1000" velocity="10.0"/>
  </joint>

  <link name="BR_leg">
    <inertial><origin xyz="0 0 -0.125"/><mass value="1.5"/><inertia ixx="0.01" iyy="0.01" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 -0.125"/><geometry><cylinder radius="0.025" length="0.25"/></geometry></visual>
    <collision><origin xyz="0 0 -0.125"/><geometry><cylinder radius="0.025" length="0.25"/></geometry></collision>
  </link>
  <joint name="BR_joint" type="revolute">
    <parent link="BR_hip"/><child link="BR_leg"/>
    <origin xyz="0 -0.1 -0.02" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="1000" velocity="10.0"/>
  </joint>

  <ros2_control name="IgnitionSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="FL_hip_joint"><command_interface name="position"/><state_interface name="position"/></joint>
    <joint name="FL_joint"><command_interface name="position"/><state_interface name="position"/></joint>
    <joint name="FR_hip_joint"><command_interface name="position"/><state_interface name="position"/></joint>
    <joint name="FR_joint"><command_interface name="position"/><state_interface name="position"/></joint>
    <joint name="BL_hip_joint"><command_interface name="position"/><state_interface name="position"/></joint>
    <joint name="BL_joint"><command_interface name="position"/><state_interface name="position"/></joint>
    <joint name="BR_hip_joint"><command_interface name="position"/><state_interface name="position"/></joint>
    <joint name="BR_joint"><command_interface name="position"/><state_interface name="position"/></joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/ubuntu/quadruped_sim/leg_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="FL_leg">
    <mu1>1000.0</mu1>
    <mu2>1000.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.005</minDepth>
  </gazebo>

  <gazebo reference="FR_leg">
    <mu1>1000.0</mu1>
    <mu2>1000.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.005</minDepth>
  </gazebo>

  <gazebo reference="BL_leg">
    <mu1>1000.0</mu1>
    <mu2>1000.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.005</minDepth>
  </gazebo>

  <gazebo reference="BR_leg">
    <mu1>1000.0</mu1>
    <mu2>1000.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.005</minDepth>
  </gazebo>
</robot>
